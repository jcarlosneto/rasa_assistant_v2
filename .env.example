# VARIAVEIS DE AMBIENTE - copie para .env  (o `python run.py setup` faz isso)
# O arquivo .env NAO vai para o Git (esta no .gitignore). Nunca publique chaves.

# --- Interface web -------------------------------------------------------
FLASK_PORT=5001
# 127.0.0.1 = so esta maquina. Para a turma acessar pela rede local use 0.0.0.0
# (leia antes o aviso de privacidade no README).
FLASK_HOST=127.0.0.1

# --- Rasa ----------------------------------------------------------------
RASA_SERVER_URL=http://localhost:5005
RASA_ACTION_SERVER_URL=http://localhost:5055

# --- Banco de dados ------------------------------------------------------
DATABASE_PATH=database/atividades.db

# --- Clima (opcional) ----------------------------------------------------
# Sem chave, a saudacao funciona normalmente, so nao mostra o clima.
# Chave gratuita: https://openweathermap.org/api
OPENWEATHER_API_KEY=
DEFAULT_CITY=São Paulo

# --- LLM do "Duelo 1.0 x 2.0" (opcional) ---------------------------------
# Sem estes tres valores, o lado do LLM fica desligado e NADA e enviado para fora.
# LLM_PROVIDER: openai     -> qualquer API compativel com Chat Completions
#                             (OpenAI, OpenRouter, Groq, Ollama local...)
#               anthropic  -> API Messages da Anthropic
# LLM_MODEL: o nome EXATO do modelo, copiado da documentacao do provedor no dia
#            (nomes de modelo mudam com frequencia; por isso nao ha valor padrao).
# LLM_BASE_URL: so para provedores compativeis, ex.: http://localhost:11434/v1 (Ollama)
#
# Exemplo: Ollama rodando no Google Colab, exposto por um tunel ngrok
#   LLM_PROVIDER=openai
#   LLM_API_KEY=ollama                 (o Ollama nao confere a chave; qualquer texto serve)
#   LLM_MODEL=qwen2.5:7b               (confira o nome exato em <URL>/v1/models)
#   LLM_BASE_URL=https://SEU-SUBDOMINIO.ngrok-free.app/v1   (termina em /v1)
#   LLM_TIMEOUT=120                    (a 1a chamada carrega o modelo e pode passar de 30 s)
# Cuidados: o URL do ngrok gratuito muda a cada sessao (atualize aqui e reinicie a
# interface); o tunel fica PUBLICO e sem senha enquanto estiver aberto; a frase
# digitada sai desta maquina (vai ao Colab e ao ngrok). Nunca publique o URL real.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT=30
